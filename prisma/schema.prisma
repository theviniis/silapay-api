generator client {
  provider          = "prisma-client-js"
  ourput            = "../generated/prisma"
  shadowDatabaseUrl = "(function)"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id
  name        String
  description String
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
